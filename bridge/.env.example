# Shared secret every caller sends as `Authorization: Bearer <token>`.
BRIDGE_TOKEN=replace-with-a-long-random-token

PORT=8787

# --- Docker mode (docker compose up) ---
# Host directory mounted into the container at /workspace.
HOST_WORKSPACE=C:\Projects
# Optional host->container path rewrite, e.g. C:\Projects:/workspace. Leave blank
# if callers already send /workspace/... paths.
PATH_MAPPINGS=

# Auth precedence: "local" (default) prefers a local/subscription login and uses
# API keys only as a fallback; "api" always uses API keys.
AUTH_PREFERENCE=local

# Auth mode A: API keys (used as fallback under local-first, or always under api).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Monthly USD budget per provider (blank or 0 = no limit). When exceeded,
# POST /v1/runs returns 402 before spawning the agent.
CLAUDE_MONTHLY_LIMIT_USD=
GPT_MONTHLY_LIMIT_USD=

# Codex reports tokens, not USD; these per-1M-token rates estimate its cost.
# Defaults are placeholders — set them to your model's real pricing.
CODEX_PRICE_INPUT_PER_MTOK=
CODEX_PRICE_CACHED_INPUT_PER_MTOK=
CODEX_PRICE_OUTPUT_PER_MTOK=

# Adapter used when a request omits "adapter" (claude | codex). Blank = required.
DEFAULT_AI_PROVIDER=

# Seconds to wait after SIGTERM before escalating to SIGKILL on cancel/timeout.
GRACE_SEC=5

# --- Host mode only (npm run dev, no Docker) ---
# Bind address and the real host dirs callers may target. Ignored in Docker mode
# (docker-compose.yml sets HOST=0.0.0.0 and WORKSPACE_ALLOWLIST=/workspace).
# HOST=127.0.0.1
# WORKSPACE_ALLOWLIST=C:\Projects

# Request-supplied env keys allowed through to the agent process.
ENV_ALLOWLIST=OPENAI_API_KEY,ANTHROPIC_API_KEY

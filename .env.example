# ── AI 프로바이더 ─────────────────────────────────────────────
# claude(Anthropic API) | gpt(OpenAI API) | claude-cli | codex-cli (bridge 경유)
DEFAULT_AI_PROVIDER=claude

# API 키 (사용하는 프로바이더 것만 설정)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# 월간 사용액 한도 (USD) — liby 표시/차단용. 초과 시 해당 프로바이더 차단
CLAUDE_MONTHLY_LIMIT_USD=2.00
GPT_MONTHLY_LIMIT_USD=2.00

# ── agent-runner-bridge (Claude Code CLI / Codex CLI 게이트웨이, 선택) ──
# 구독 인증(Claude Pro / ChatGPT Plus)으로 추가 비용 없이 분석하려면 사용.
# docker compose 사용 시 BRIDGE_BASE_URL/BRIDGE_CWD는 자동 설정되며,
# BRIDGE_TOKEN(임의의 긴 문자열)만 설정하면 됨 — liby와 bridge 양쪽에 주입됨.
BRIDGE_TOKEN=
# 수동 실행(비 Docker) 시에만 필요:
BRIDGE_BASE_URL=http://127.0.0.1:8787
BRIDGE_CWD=/workspace/liby-runs
BRIDGE_TIMEOUT_SEC=900
# bridge 자체 월 예산 한도(USD) — 구독 모드는 실제 추가 비용이 0이라 기본 무제한(빈 값).
# bridge가 토큰 추정 비용으로 분석을 차단하지 않게 비워둠. API 키 모드에서 상한을
# 두려면 값 설정. (liby의 CLAUDE_MONTHLY_LIMIT_USD와 분리됨)
BRIDGE_CLAUDE_LIMIT_USD=
BRIDGE_GPT_LIMIT_USD=

# ── Docker ───────────────────────────────────────────────────
# 호스트 포트가 이미 사용 중이면 변경 (docker compose 전용)
LIBY_PORT=8000

# ── 저장 경로 ─────────────────────────────────────────────────
VAULT_PATH=./vault
DB_PATH=./liby.db

# ── Discord 봇 + 외부 열람 (선택 — docs/operations-discord-tailscale.md 참고) ──
# 토큰이 비어 있으면 봇은 비활성화됨
DISCORD_LIBY_TOKEN=
DISCORD_LIBY_CHANNEL_ID=
# Tailscale MagicDNS 주소 등 외부에서 접근 가능한 베이스 URL
PUBLIC_BASE_URL=http://127.0.0.1:8000
# 선택: 내부 봇 API 추가 보호용 임의 문자열
BOT_API_TOKEN=
